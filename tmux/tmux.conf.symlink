# Colors
set -g default-terminal "screen-256color"

# Copy selections to the outer terminal clipboard over SSH when supported.
set -g set-clipboard on
set -as terminal-overrides ',*:Ms=\E]52;c;%p2%s\7'

# Shorten input delay
set -sg escape-time 10

# Start window numbering at 1 instead of 0
set -g base-index 1
set -g pane-base-index 1
set -g renumber-windows on

# Reload tmux.conf easily
bind r source-file ~/.tmux.conf \; display "tmux.conf reloaded"

# Remap prefix to Control + a
set -g prefix C-a
unbind C-b

# Send prefix to app inside tmux
bind C-a send-prefix

# Easier window splitting
unbind %
bind \\ split-window -h
bind - split-window -v

# Pane movement
bind h select-pane -L
bind j select-pane -D
bind k select-pane -U
bind l select-pane -R

# Faster pane resizing
bind H resize-pane -L 5
bind J resize-pane -D 5
bind K resize-pane -U 5
bind L resize-pane -R 5

# Mouse Support
set-option -g mouse on

# Mouse and keyboard copy mode
setw -g mode-keys vi
bind-key -T copy-mode-vi y send-keys -X copy-selection-and-cancel
bind-key -T copy-mode-vi MouseDragEnd1Pane send-keys -X copy-selection-and-cancel
