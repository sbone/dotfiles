set nocompatible
syntax on
filetype indent on

" Two-space indentation
set tabstop=2 shiftwidth=2 expandtab
set autoindent
set backspace=indent,eol,start

" Display
set background=dark
set number cursorline
set nowrap
set scrolloff=8
set showmatch

" Search as you type; match case only when the query has capitals
set incsearch nohlsearch
set ignorecase smartcase

" Move around splits with Ctrl-h/j/k/l
nnoremap <C-h> <C-w>h
nnoremap <C-j> <C-w>j
nnoremap <C-k> <C-w>k
nnoremap <C-l> <C-w>l

" Avoid entering Ex mode accidentally
nnoremap Q <Nop>
